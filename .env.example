# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:4200

# Database (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/backend_db

# WebSockets / Django Channels
# Poner en False para usar InMemoryChannelLayer sin necesidad de Redis
# (sirve para probar en una sola máquina; en producción siempre True).
USE_REDIS_CHANNEL_LAYER=True
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Google OAuth2
GOOGLE_OAUTH2_KEY=your-google-client-id
GOOGLE_OAUTH2_SECRET=your-google-client-secret

# GitHub OAuth2
GITHUB_APP_ID=your-github-app-id
GITHUB_SECRET=your-github-secret

# Email Configuration for Password Reset
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@example.com

# Note: For Gmail, use an App Password (not your regular password)
# https://support.google.com/accounts/answer/185833


# ─── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
# En ECS detrás de un ALB, agregar el dominio público y el health check:
# ALLOWED_HOSTS=api.midominio.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes https habilitados para POST (admin, formularios). Solo en producción.
# CSRF_TRUSTED_ORIGINS=https://api.midominio.com
CSRF_TRUSTED_ORIGINS=

# Confiar en el header X-Forwarded-Proto del balanceador. Poner True solo si
# hay un ALB/CloudFront adelante terminando TLS.
USE_X_FORWARDED_PROTO=False

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# URL del frontend para los redirects de OAuth
FRONTEND_URL=http://localhost:4200

# ─── Base de datos ───────────────────────────────────────────────────────────
# Si DB_HOST está vacío se usa SQLite (desarrollo y tests).
# Con DB_HOST definido se usa PostgreSQL: 'postgres' en docker compose,
# o el endpoint de RDS en producción.
DB_HOST=
DB_PORT=5432
DB_NAME=backend_db
DB_USER=postgres
DB_PASSWORD=
DB_CONN_MAX_AGE=60

# ─── WebSockets / Django Channels ────────────────────────────────────────────
# False usa InMemoryChannelLayer y no necesita Redis, pero solo funciona con
# un único proceso: en producción siempre True (ElastiCache / Redis).
USE_REDIS_CHANNEL_LAYER=True
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── Arranque del contenedor ─────────────────────────────────────────────────
# Con más de una réplica conviene False y correr las migraciones como una
# tarea aparte, para que las tareas no compitan entre sí al desplegar.
RUN_MIGRATIONS=True
DB_WAIT_TIMEOUT=60

# Superusuario opcional: si ambas están definidas, el entrypoint lo crea.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=

# ─── Cifrado de campos ───────────────────────────────────────────────────────
# Generar una propia y NO reutilizar la de desarrollo:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si cambia, los datos ya cifrados dejan de poder leerse.
# FIELD_ENCRYPTION_KEY=

# ─── OAuth2 ──────────────────────────────────────────────────────────────────
GOOGLE_OAUTH2_KEY=your-google-client-id
GOOGLE_OAUTH2_SECRET=your-google-client-secret

GITHUB_APP_ID=your-github-app-id
GITHUB_SECRET=your-github-secret

# ─── Email (recuperación de contraseña) ──────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@example.com

# Nota: con Gmail hay que usar una App Password, no la contraseña de la cuenta.
# https://support.google.com/accounts/answer/185833

# ─── Despliegue en ECR (solo para deploy/ecr-push.sh) ────────────────────────
# AWS_REGION=us-east-1
# ECR_REPOSITORY=ispc-progiii-backend
# AWS_ACCOUNT_ID=123456789012

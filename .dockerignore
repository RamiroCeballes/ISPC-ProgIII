.cache
.mypy_cache

# Estáticos: los regenera collectstatic dentro del build
staticfiles
media

# Documentación y utilidades que no hacen falta en runtime
DOCUMENTATION.md
*.postman_collection.json
setup.sh
setup.bat
docker-compose.yml
Dockerfile
.dockerignore

